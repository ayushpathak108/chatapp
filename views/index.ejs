<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Socket.IO Chat App</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Phosphor Icons -->
  <script src="https://unpkg.com/@phosphor-icons/web"></script>
  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f1f5;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="bg-slate-100 font-sans antialiased text-slate-800 h-screen flex flex-col justify-center items-center p-2 sm:p-4">

  <!-- =============================== -->
  <!-- 1. LOGIN SCREEN                 -->
  <!-- =============================== -->
  <div id="login-screen" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-sm w-full p-8 border border-slate-100 text-center">
      <div class="w-16 h-16 bg-indigo-600/10 text-indigo-600 rounded-2xl mx-auto flex items-center justify-center text-3xl mb-4">
        <i class="ph ph-chat-teardrop-dots-fill"></i>
      </div>
      <h2 class="text-2xl font-bold text-slate-800">Welcome to ChatApp</h2>
      <p class="text-sm text-slate-500 mt-1 mb-6">Enter your username to join the chat</p>
      
      <form onsubmit="handleJoin(event)" class="space-y-4">
        <div class="text-left">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Username</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="ph ph-user text-lg"></i>
            </span>
            <input 
              type="text" 
              id="username-input" 
              required 
              placeholder="e.g. Ayush, Aryan..." 
              autocomplete="off"
              class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none focus:bg-white text-sm transition"
            >
          </div>
        </div>
        <button 
          type="submit" 
          class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 rounded-xl transition duration-150 shadow-md shadow-indigo-200 flex items-center justify-center gap-2"
        >
          <span>Join Chat</span>
          <i class="ph ph-arrow-right font-bold"></i>
        </button>
      </form>
    </div>
  </div>

  <!-- =============================== -->
  <!-- 2. MAIN 2-COLUMN CHAT CONTAINER -->
  <!-- =============================== -->
  <div id="chat-app" class="w-full max-w-6xl h-[92vh] bg-white rounded-3xl shadow-xl border border-slate-200/80 overflow-hidden flex flex-col md:flex-row">
    
    <!-- LEFT SIDEBAR: PROFILE & ACTIVE USERS -->
    <aside class="w-full md:w-80 lg:w-96 border-r border-slate-200 flex flex-col bg-slate-50/70 select-none">
      
      <!-- User Profile Header -->
      <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-white">
        <div class="flex items-center gap-3">
          <div class="relative">
            <img 
              id="my-avatar"
              src="https://api.dicebear.com/7.x/bottts/svg?seed=User" 
              alt="My Avatar" 
              class="w-10 h-10 rounded-full bg-indigo-100 p-0.5 border border-indigo-200"
            />
            <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></span>
          </div>
          <div>
            <h3 id="current-user-display" class="font-semibold text-slate-800 text-sm leading-tight">You</h3>
            <span class="text-xs text-emerald-600 font-medium flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Online
            </span>
          </div>
        </div>
      </div>

      <!-- Channels & Global Room Button -->
      <div class="p-3">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-3 py-1">Channels</div>
        <button 
          id="btn-global-chat" 
          onclick="switchChat('global')" 
          class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl bg-indigo-600 text-white font-medium shadow-sm transition"
        >
          <div class="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center text-lg">
            <i class="ph ph-globe"></i>
          </div>
          <div class="flex-1 text-left">
            <div class="text-sm font-semibold flex items-center justify-between">
              <span>🌐 Global Chat</span>
              <span class="text-[10px] bg-white/30 text-white px-2 py-0.5 rounded-full">Public</span>
            </div>
            <p class="text-xs text-indigo-100 truncate">Chat with everyone</p>
          </div>
        </button>
      </div>

      <!-- Online Users List -->
      <div class="flex-1 overflow-y-auto px-3 pb-3 space-y-1">
        <div class="flex items-center justify-between px-3 py-2">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Direct Messages</span>
          <span id="online-users-count" class="text-xs font-semibold px-2 py-0.5 bg-slate-200 text-slate-700 rounded-full">0</span>
        </div>

        <div id="users-list-container" class="space-y-1">
          <!-- Dynamically populated online users -->
          <p id="no-other-users" class="text-xs text-slate-400 text-center py-4">No other users online yet</p>
        </div>
      </div>
    </aside>

    <!-- RIGHT MAIN CHAT AREA -->
    <main class="flex-1 flex flex-col bg-white overflow-hidden">
      
      <!-- Chat Header -->
      <div class="h-16 border-b border-slate-200 px-6 flex items-center justify-between bg-white/80 backdrop-blur-sm z-10">
        <div class="flex items-center gap-3">
          <div id="active-chat-avatar-container">
            <div id="active-chat-avatar" class="w-10 h-10 rounded-full bg-indigo-50 border border-indigo-200 flex items-center justify-center text-indigo-600 text-xl font-bold">
              🌐
            </div>
          </div>
          <div>
            <h2 id="active-chat-title" class="font-bold text-slate-800 text-base leading-tight">Global Room</h2>
            <p id="active-chat-subtitle" class="text-xs text-slate-400 flex items-center gap-1.5 mt-0.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Public Room (Everyone can read)
            </p>
          </div>
        </div>
      </div>

      <!-- Messages Scroll Area -->
      <div id="chat-messages-container" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 bg-slate-50/40">
        <div class="text-center my-2">
          <span class="inline-block text-[11px] font-medium bg-slate-200/70 text-slate-600 px-3 py-1 rounded-full shadow-sm">
            🔒 Connected via WebSockets
          </span>
        </div>
      </div>

      <!-- Bottom Chat Input Bar -->
      <div class="p-3 sm:p-4 border-t border-slate-200 bg-white">
        <form onsubmit="handleSendMessage(event)" class="flex items-center gap-2">
          
          <!-- Emoji Button -->
          <button type="button" onclick="insertEmoji('🔥')" class="p-2.5 text-slate-400 hover:text-amber-500 hover:bg-slate-100 rounded-xl transition">
            <i class="ph ph-smiley text-xl"></i>
          </button>

          <!-- Input Field -->
          <input 
            type="text" 
            id="message-input" 
            required 
            placeholder="Type your message here... (Press Enter to Send)" 
            autocomplete="off"
            class="flex-1 bg-slate-100 border border-slate-200/80 rounded-xl px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition"
          >

          <!-- Send Button -->
          <button 
            type="submit" 
            class="bg-indigo-600 hover:bg-indigo-700 active:scale-95 text-white px-5 py-3 rounded-xl font-medium shadow-md shadow-indigo-200 transition flex items-center gap-1.5"
          >
            <span class="hidden sm:inline text-sm">Send</span>
            <i class="ph ph-paper-plane-right-fill text-lg"></i>
          </button>
        </form>
      </div>

    </main>
  </div>

  <!-- Socket.IO Client -->
  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();

    let myUsername = "";
    let activeChat = "global"; // "global" or direct username (e.g., "Rahul")
    let onlineUsers = [];

    // Local in-memory message storage per conversation
    const messagesStore = {
      global: []
    };

    // 1. Join chat handler
    function handleJoin(e) {
      e.preventDefault();
      const input = document.getElementById("username-input");
      const name = input.value.trim();
      if (!name) return;

      myUsername = name;
      document.getElementById("current-user-display").innerText = `${myUsername} (You)`;
      document.getElementById("my-avatar").src = `https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(myUsername)}`;
      document.getElementById("login-screen").classList.add("hidden");

      // Notify server
      socket.emit("joining", myUsername);
    }

    // 2. Receive online users list
    socket.on("users", (users) => {
      // Normalize users list (whether strings or objects)
      const userNames = users.map(u => (typeof u === 'string' ? u.trim() : (u.name || u.username))).filter(Boolean);
      
      // Filter out self
      onlineUsers = [...new Set(userNames.filter(u => u !== myUsername))];
      
      document.getElementById("online-users-count").innerText = onlineUsers.length;

      const container = document.getElementById("users-list-container");
      container.innerHTML = "";

      if (onlineUsers.length === 0) {
        container.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">No other users online yet</p>`;
        return;
      }

      onlineUsers.forEach(user => {
        const isCurrent = activeChat === user;
        const btn = document.createElement("button");
        btn.id = `user-tab-${user}`;
        btn.onclick = () => switchChat(user);
        btn.className = `w-full flex items-center gap-3 px-3 py-2.5 rounded-xl transition group ${
          isCurrent 
            ? "bg-white border-indigo-200 shadow-sm border" 
            : "hover:bg-white text-slate-700 hover:shadow-sm border border-transparent hover:border-slate-100"
        }`;

        btn.innerHTML = `
          <div class="relative shrink-0">
            <img src="https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(user)}" class="w-9 h-9 rounded-full bg-slate-200 p-0.5">
            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-white rounded-full"></span>
          </div>
          <div class="flex-1 text-left min-w-0">
            <div class="text-sm font-semibold text-slate-800 flex items-center justify-between">
              <span class="truncate">${escapeHtml(user)}</span>
              <span class="text-[10px] text-slate-400 font-normal">Online</span>
            </div>
            <p class="text-xs text-slate-400 truncate">Tap to direct message</p>
          </div>
        `;

        container.appendChild(btn);
      });
    });

    // 3. User notice notifications
    socket.on("user_notice", (text) => {
      appendNotice(text);
    });

    // 4. Global messages from server
    socket.on("groupmsg", (data, textParam) => {
      let sender, text, time;
      if (typeof data === 'object' && data !== null) {
        sender = data.sender;
        text = data.text || data.msg;
        time = data.time || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      } else {
        sender = data;
        text = textParam;
        time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }

      const msgObj = {
        sender,
        text,
        time,
        isMe: sender === myUsername
      };

      if (!messagesStore.global) messagesStore.global = [];
      messagesStore.global.push(msgObj);

      if (activeChat === "global") {
        renderSingleMessage(msgObj);
      }
    });

    // 5. Private messages from server
    socket.on("privately", (arg1, arg2, arg3) => {
      // Handles both object payload and (sender, text/msg, recipient)
      let sender, text, recipient, time;
      if (typeof arg1 === 'object') {
        sender = arg1.sender;
        text = arg1.text || arg1.msg;
        recipient = arg1.to || arg1.user;
        time = arg1.time || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      } else {
        sender = arg1;
        text = arg2;
        recipient = arg3;
        time = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }

      const isMe = sender === myUsername;
      const otherPerson = isMe ? recipient : sender;

      if (!otherPerson) return;

      const msgObj = {
        sender,
        text,
        time,
        isMe
      };

      if (!messagesStore[otherPerson]) {
        messagesStore[otherPerson] = [];
      }
      messagesStore[otherPerson].push(msgObj);

      if (activeChat === otherPerson) {
        renderSingleMessage(msgObj);
      }
    });

    // 6. Switch Chat (Global vs Private)
    function switchChat(target) {
      activeChat = target;

      const globalBtn = document.getElementById("btn-global-chat");
      if (target === "global") {
        globalBtn.className = "w-full flex items-center gap-3 px-3 py-2.5 rounded-xl bg-indigo-600 text-white font-medium shadow-sm transition";
        
        // Header
        document.getElementById("active-chat-avatar").innerHTML = "🌐";
        document.getElementById("active-chat-avatar").className = "w-10 h-10 rounded-full bg-indigo-50 border border-indigo-200 flex items-center justify-center text-indigo-600 text-xl font-bold";
        document.getElementById("active-chat-title").innerText = "Global Room";
        document.getElementById("active-chat-subtitle").innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span> Public Room (Everyone can read)';
      } else {
        globalBtn.className = "w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-white text-slate-700 hover:shadow-sm border border-transparent hover:border-slate-100 transition";
        
        // Header
        document.getElementById("active-chat-avatar").innerHTML = `<img src="https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(target)}" class="w-full h-full rounded-full">`;
        document.getElementById("active-chat-avatar").className = "w-10 h-10 rounded-full overflow-hidden border border-slate-200";
        document.getElementById("active-chat-title").innerText = `@${target}`;
        document.getElementById("active-chat-subtitle").innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-500"></span> Direct 1-on-1 Private Message';
      }

      // Update sidebar tab highlights
      onlineUsers.forEach(u => {
        const el = document.getElementById(`user-tab-${u}`);
        if (el) {
          if (u === target) {
            el.className = "w-full flex items-center gap-3 px-3 py-2.5 rounded-xl bg-white border-indigo-200 shadow-sm border transition group";
          } else {
            el.className = "w-full flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-white text-slate-700 hover:shadow-sm border border-transparent hover:border-slate-100 transition group";
          }
        }
      });

      renderMessages();
    }

    // 7. Send Message
    function handleSendMessage(e) {
      e.preventDefault();
      const input = document.getElementById("message-input");
      const text = input.value.trim();
      if (!text) return;

      if (activeChat === "global") {
        socket.emit("groupmsg", myUsername, text);
      } else {
        socket.emit("privately", myUsername, activeChat, text);
      }

      input.value = "";
      input.focus();
    }

    // 8. Render All Messages for Current View
    function renderMessages() {
      const container = document.getElementById("chat-messages-container");
      container.innerHTML = `
        <div class="text-center my-2">
          <span class="inline-block text-[11px] font-medium bg-slate-200/70 text-slate-600 px-3 py-1 rounded-full shadow-sm">
            🔒 Connected to ${activeChat === 'global' ? 'Global Room' : 'private chat with @' + activeChat}
          </span>
        </div>
      `;

      const list = messagesStore[activeChat] || [];
      list.forEach(msg => renderSingleMessage(msg, false));
      container.scrollTop = container.scrollHeight;
    }

    // 9. Append a single message bubble
    function renderSingleMessage(msg, autoScroll = true) {
      const container = document.getElementById("chat-messages-container");

      if (msg.isMe) {
        container.innerHTML += `
          <div class="flex flex-col items-end max-w-[80%] ml-auto">
            <div class="bg-indigo-600 text-white rounded-2xl rounded-br-sm p-3.5 shadow-md shadow-indigo-100 text-sm leading-relaxed">
              ${escapeHtml(msg.text)}
            </div>
            <span class="text-[10px] text-slate-400 mr-1.5 mt-0.5 block">${msg.time} · Sent</span>
          </div>
        `;
      } else {
        container.innerHTML += `
          <div class="flex items-end gap-2.5 max-w-[80%]">
            <img src="https://api.dicebear.com/7.x/bottts/svg?seed=${encodeURIComponent(msg.sender)}" class="w-7 h-7 rounded-full bg-slate-200 shrink-0 mb-1">
            <div>
              <span class="text-xs font-semibold text-slate-600 ml-1">${escapeHtml(msg.sender)}</span>
              <div class="bg-white border border-slate-200/80 rounded-2xl rounded-bl-sm p-3.5 shadow-sm text-sm text-slate-800 leading-relaxed">
                ${escapeHtml(msg.text)}
              </div>
              <span class="text-[10px] text-slate-400 ml-1.5 mt-0.5 block">${msg.time}</span>
            </div>
          </div>
        `;
      }

      if (autoScroll) {
        container.scrollTop = container.scrollHeight;
      }
    }

    function appendNotice(text) {
      const container = document.getElementById("chat-messages-container");
      container.innerHTML += `
        <div class="text-center my-1.5">
          <span class="text-[11px] bg-slate-100 text-slate-500 px-3 py-1 rounded-full border border-slate-200/60">
            ${escapeHtml(text)}
          </span>
        </div>
      `;
      container.scrollTop = container.scrollHeight;
    }

    function insertEmoji(emoji) {
      const input = document.getElementById("message-input");
      input.value += emoji + " ";
      input.focus();
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.innerText = text;
      return div.innerHTML;
    }
  </script>
</body>
</html>